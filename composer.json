{
    "name": "markocupic/phpoffice-bundle",
    "description": "PhpOffice helper classes",
    "keywords": [
        "docx",
        "template processor helper"
    ],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/phpoffice-bundle/issues",
        "source": "https://github.com/markocupic/phpoffice-bundle"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3 || ^6.0",
        "phpoffice/phpword": "^1.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.12",
        "contao/test-case": "^5.3 || ^6.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\PhpOfficeBundle\\": "src/",
            "Markocupic\\PhpOffice\\": "src/PhpOffice/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markocupic\\PhpOfficeBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\PhpOfficeBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false,
            "contao-community-alliance/composer-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --fix --ansi",
        "cs-check": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --ansi",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    }
}
